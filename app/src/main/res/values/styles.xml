<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Awan" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/lapis_900</item>
        <item name="android:colorBackground">@color/lapis_900</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- Screensaver now, on black from the first frame like the screensaver itself. -->
    <style name="Theme.Awan.Saver">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- The call to prayer: drawn over whatever was on, which shows faintly through its dimmed ground. -->
    <style name="Theme.Awan.Call">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
