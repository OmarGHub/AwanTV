<?xml version="1.0" encoding="utf-8"?>
<!-- The installer's icon: a TV with the arch on its screen inside the gold arch, as on its first page; adaptive, so a
     phone's mask (circle, squircle, rounded square) never cuts the drawing, with a monochrome layer for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
